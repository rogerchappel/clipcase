{
  "project": "clipcase",
  "source": "docs/PRD.md",
  "status": "mvp-complete",
  "commands": [
    "init",
    "new",
    "add",
    "list",
    "show",
    "search",
    "export"
  ],
  "storage": {
    "default": ".clipcase",
    "configFile": ".clipcase.json",
    "entryFormat": "markdown",
    "indexFormat": "json"
  },
  "qualityGates": [
    "npx --yes npm@10.9.4 ci",
    "npx --yes npm@10.9.4 run release:check"
  ],
  "security": {
    "secretBlocking": true,
    "overrideFlag": "--allow-secret",
    "networkRequired": false
  },
  "ci": {
    "workflow": ".github/workflows/ci.yml",
    "nodeVersions": [
      20,
      22,
      24
    ],
    "steps": [
      "npx --yes npm@10.9.4 ci",
      "npx --yes npm@10.9.4 run release:check"
    ],
    "releaseCheckIncludes": [
      "npm test",
      "npm run check",
      "npm run build",
      "npm run smoke",
      "npm run package:smoke",
      "npm run release:contract",
      "bash scripts/validate.sh"
    ],
    "validationScriptIsSeparateCiStep": false
  }
}
